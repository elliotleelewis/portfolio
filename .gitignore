# build output
dist/
# Compiled from messages/ by Paraglide.
src/paraglide/
# Paraglide's cache and bookkeeping. Only the settings are source.
project.inlang/*
!project.inlang/settings.json

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# Playwright
test-results/
playwright-report/
# Screenshots from `pnpm shots`
shots/out/

# Wrangler's local state, like local D1 databases
.wrangler/
