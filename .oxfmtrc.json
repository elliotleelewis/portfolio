{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "astro": true,
  "bracketSpacing": true,
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.json", "*.md", "*.yaml", "*.yml"],
      "options": {
        "tabWidth": 2,
        "useTabs": false
      }
    }
  ],
  "printWidth": 80,
  "semi": true,
  "singleQuote": true,
  "sortPackageJson": false,
  "tabWidth": 4,
  "trailingComma": "all",
  "useTabs": true
}
