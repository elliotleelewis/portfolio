    "lint:agents": "agnix --strict .",
    "lint:fix": "pnpm run lint:code --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "knip": "knip",
    "test": "vitest run src functions",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate && oxfmt migrations"
  },
