{
  "name": "portfolio",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "prepare": "husky && paraglide-js compile --strategy baseLocale",
    "astro": "astro",
    "start": "astro dev --host",
    "build": "astro check && astro build",
