{
  "name": "portfolio",
  "packageManager": "pnpm@12.8.2",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "prepare": "husky && paraglide-js compile --strategy baseLocale",
    "astro": "astro",
    "start": "astro dev --host",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "lint": "eslint --max-warnings 0 \"**/*.{ts,tsx,astro}\"",
    "lint:fix": "pnpm run lint --fix",
    "format": "prettier --check \"**/*.{md,ts,tsx,js,cjs,mjs,scss,html,json,yml,astro}\" --ignore-path .gitignore",
    "format:fix": "pnpm run format --write",
    "test": "vitest run --dir src",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@astrojs/sitemap": "^3.0.0",
    "@react-three/fiber": "^9.0.0",
    "astro": "^7.0.0",
    "astro-robots-txt": "^1.0.0",
    "jotai": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.0",
    "tailwindcss": "^4.0.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@axe-core/playwright": "^4.0.0",
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@commitlint/types": "^21.0.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.0.0",
    "@eslint/js": "^10.0.0",
    "@inlang/paraglide-js": "^2.0.0",
    "@inlang/paraglide-js-react": "^1.0.0",
    "@inlang/plugin-message-format": "^4.0.0",
    "@playwright/test": "^1.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/eslint-plugin-jsx-a11y": "^6.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-astro": "^3.0.0",
    "eslint-plugin-better-tailwindcss": "^4.0.0",
    "eslint-plugin-import-x": "^4.0.0",
    "eslint-plugin-jsdoc": "^65.0.0",
    "eslint-plugin-jsx-a11y": "^6.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-unicorn": "^76.0.0",
    "globals": "^17.0.0",
    "happy-dom": "^20.0.0",
    "husky": "^9.0.0",
    "jiti": "~2.7.0",
    "oxc-transform-react": "^0.152.0",
    "prettier": "~3.9.0",
    "prettier-plugin-astro": "^1.0.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
