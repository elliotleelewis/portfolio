# Cloudflare Pages' headers for the static site. The leaderboard's Function
# (functions/) sets its own, with Hono's secureHeaders, and these don't reach
# it. Pages already sends nosniff, a referrer policy and HSTS.

# No other site can frame the page, to trick a tap onto it.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY

# The build's own files are named by their contents, so a changed one is a
# new name: browsers keep them for a year without asking again.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
