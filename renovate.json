{
  "repositories": ["elliotleelewis/portfolio"],
  "extends": [
    "config:recommended",
    "security:minimumReleaseAgeNpm",
    ":preserveSemverRanges"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  }
}
