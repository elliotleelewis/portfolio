---
interface Props {
	title: string;
	from: string;
	to?: string;
	place: string;
}

const { title, from, to = 'Present', place } = Astro.props;
---

<!-- A role at a company, with its highlights (and any extras, folded away). -->
<div>
	<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
		<h4 class="text-lg font-semibold">{title}</h4>
		<p class="font-mono text-xs text-muted">
			{from} – {to} · {place}
		</p>
	</div>
	<div class="mt-3 leading-relaxed text-ink/85 [&_li]:ps-1 [&_strong]:font-semibold [&_strong]:text-accent [&_ul]:flex [&_ul]:list-disc [&_ul]:flex-col [&_ul]:gap-2 [&_ul]:ps-5 [&_ul]:marker:text-accent">
		<slot />
	</div>
	{Astro.slots.has('more') && (
		<details class="group mt-3">
			<summary class="inline-flex cursor-pointer list-none items-center gap-1.5 font-mono text-xs tracking-widest text-muted uppercase hover:text-ink [&::-webkit-details-marker]:hidden">
				<span class="group-open:hidden">More</span>
				<span class="hidden group-open:inline">Less</span>
				<span
					class="transition group-open:rotate-180"
					aria-hidden="true"
				>
					↓
				</span>
			</summary>
			<div class="mt-3 leading-relaxed text-ink/85 [&_li]:ps-1 [&_ul]:flex [&_ul]:list-disc [&_ul]:flex-col [&_ul]:gap-2 [&_ul]:ps-5 [&_ul]:marker:text-accent">
				<slot name="more" />
			</div>
		</details>
	)}
</div>
