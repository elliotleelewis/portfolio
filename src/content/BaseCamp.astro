---
import { Image } from 'astro:assets';

import SectionHeading from '../components/SectionHeading.astro';
import mmu from '../media/mmu.svg';
import { m } from '../paraglide/messages';
---

<!-- Education: where the trail started. -->
<section class="pt-28 pb-32" aria-labelledby="camp-title">
	<SectionHeading
		id="camp-title"
		marker="03"
		kicker={m.camp_kicker()}
		title={m.camp_title()}
	/>
	<div
		class="flex flex-col gap-5 rounded-xl border border-line bg-surface p-6 sm:flex-row sm:items-start sm:p-8"
		data-reveal
	>
		<div class="grid size-12 shrink-0 place-items-center rounded-md bg-snow p-2">
			<Image src={mmu} alt="" class="size-8" width={32} height={32} />
		</div>
		<div class="flex-1">
			<p class="font-mono text-xs tracking-widest text-muted uppercase">
				{m.role_dates({
					from: '2015-09',
					to: '2019-05',
					place: m.place_manchester(),
				})}
			</p>
			<h3 class="mt-2 font-display text-2xl font-semibold tracking-tight">
				{m.camp_degree()}
			</h3>
			<p class="mt-1 text-muted">{m.camp_university()}</p>
			<ul class="mt-5 flex flex-wrap gap-2">
				<li class="rounded-lg border border-accent/40 px-3 py-1 text-sm font-medium text-accent">
					{m.camp_first_class()}
				</li>
				<li class="rounded-lg border border-accent/40 px-3 py-1 text-sm font-medium text-accent">
					{m.camp_excellence()}
				</li>
			</ul>
		</div>
	</div>
</section>
