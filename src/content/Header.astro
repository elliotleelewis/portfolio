---
import { Image } from 'astro:assets';

import Card from '../components/Card.astro';
import profile from '../media/profile.jpg';
---

<Card>
	<div
		class="flex flex-col items-center gap-1 text-center sm:flex-row sm:gap-4 sm:text-start"
	>
		<Image
			class="size-24 rounded-full sm:size-32"
			src={profile}
			alt="Profile Pic"
			width="128"
			height="128"
			densities={[1.5, 2]}
		/>
		<div
			class="flex w-full flex-col items-center justify-between gap-1 sm:items-start lg:flex-row lg:items-center lg:gap-4"
		>
			<h1 class="text-4xl font-bold lg:text-5xl xl:text-6xl">
				Elliot <span
					class="bg-linear-to-r from-yellow-400 to-amber-700/80 bg-size-[300%] bg-clip-text text-transparent"
					>Lewis</span
				>
			</h1>
			<div class="text-center sm:text-start lg:text-end">
				<h2 class="mb-0.5 text-xl font-normal lowercase">
					Front-end Engineer
				</h2>
				<h2 class="text-lg font-normal lowercase">
					Los Angeles, California
				</h2>
			</div>
		</div>
	</div>
</Card>
