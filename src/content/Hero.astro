---
import { getImage } from 'astro:assets';

import { Hero } from '../hero/hero';
import hero from '../media/hero.webp';
import { m } from '../paraglide/messages';

import { PHONE_MEDIA, WIDE_MEDIA, heroPhoto } from './hero-photo';

const options = heroPhoto(hero);
const [phone, wide, fallback] = await Promise.all([
	getImage(options.phone),
	getImage(options.wide),
	getImage(options.fallback),
]);
const { phoneSizes, wideSizes } = options;

// The hero hydrates once the browser is idle, so React's download doesn't
// slow the photo's on a phone. Until then the photo shows, Play is
// disabled, and the theme picker isn't drawn.
---

<Hero client:idle>
	<picture>
		<source
			media={PHONE_MEDIA}
			type="image/avif"
			srcset={phone.srcSet.attribute}
			sizes={phoneSizes}
		/>
		<source
			media={WIDE_MEDIA}
			type="image/avif"
			srcset={wide.srcSet.attribute}
			sizes={wideSizes}
		/>
		<img
			src={fallback.src}
			srcset={fallback.srcSet.attribute}
			sizes={`${WIDE_MEDIA} ${wideSizes}, ${phoneSizes}`}
			alt={m.hero_photo_alt()}
			width={fallback.attributes.width}
			height={fallback.attributes.height}
			class="absolute inset-0 size-full object-cover object-[50%_45%] transition-opacity duration-1500 ease-in-out group-data-[state=playing]:opacity-0"
			loading="eager"
			fetchpriority="high"
			decoding="async"
		/>
	</picture>
</Hero>
