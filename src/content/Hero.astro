---
import { Picture } from 'astro:assets';

import { Hero } from '../hero/hero';
import hero from '../media/hero.webp';
import { m } from '../paraglide/messages';

// The photo covers the hero, so it's drawn at whichever is wider: the hero's
// width, or its height (85svh, at least 30rem) times the photo's shape
// (1717 × 1867). On a phone that's the height, so the photo is wider than
// the screen. Without allowing for it, phones would get a photo too small,
// stretched to fit. The width is the page's (at most 72rem, less its padding
// of 1rem, or 2rem from 640px up).
const sizes = [
	'(min-width: 640px) max(min(100vw, 1152px) - 64px, 78.2vh, 442px)',
	'max(100vw - 32px, 78.2vh, 442px)',
].join(', ');
---

<Hero client:load>
	<Picture
		src={hero}
		formats={['avif']}
		fallbackFormat="webp"
		alt={m.hero_photo_alt()}
		class="absolute inset-0 size-full object-cover object-[50%_45%] transition-opacity duration-1500 ease-in-out group-data-[state=playing]:opacity-0"
		widths={[640, 960, 1280, 1717]}
		sizes={sizes}
		loading="eager"
		fetchpriority="high"
	/>
</Hero>
