---
import { RichText } from '../components/rich-text';
import Role from '../components/Role.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Waypoint from '../components/Waypoint.astro';
import jabil from '../media/jabil.svg';
import snap from '../media/snap.svg';
import stubhub from '../media/stubhub.svg';
import { m } from '../paraglide/messages';
---

<!-- Experience, as waypoints down a trail. -->
<section class="pt-28" aria-labelledby="trail-title">
	<SectionHeading
		id="trail-title"
		marker="01"
		kicker={m.trail_kicker()}
		title={m.trail_title()}
	/>
	<ol class="relative flex flex-col gap-16 border-s-2 border-dashed border-line ps-8 sm:ps-12">
		<Waypoint
			company="StubHub"
			from="2024"
			logo={stubhub}
			logoBackground="#46009b"
		>
			<Role
				title={m.role_staff_engineer()}
				from="2026-10"
				place={m.place_los_angeles()}
			/>
			<Role
				title={m.role_senior_engineer()}
				from="2024-04"
				to="2026-09"
				place={m.place_los_angeles()}
			/>
		</Waypoint>

		<Waypoint
			company="Snap Inc"
			from="2021"
			to="2024"
			logo={snap}
			logoBackground="#fffc00"
		>
			<Role
				title={m.role_engineer()}
				from="2021-08"
				to="2024-02"
				place={m.place_los_angeles()}
			>
				<ul>
					<li>
						<RichText
							message={m.trail_snap_event_insights}
							href="https://patents.google.com/patent/US11894989B2/en"
						/>
					</li>
					<li>
						<RichText message={m.trail_snap_payouts} />
					</li>
					<li>
						<RichText message={m.trail_snap_load_times} />
					</li>
				</ul>
				<ul slot="more">
					<li>{m.trail_snap_digital_goods()}</li>
					<li>{m.trail_snap_alerting()}</li>
					<li>{m.trail_snap_mentoring()}</li>
				</ul>
			</Role>
		</Waypoint>

		<Waypoint
			company="Jabil"
			from="2017"
			to="2021"
			logo={jabil}
			logoBackground="#002b49"
		>
			<Role
				title={m.role_senior_engineer()}
				from="2019-05"
				to="2021-08"
				place={m.place_st_petersburg()}
			>
				<ul>
					<li>
						<RichText message={m.trail_jabil_architect} />
					</li>
					<li>
						<RichText message={m.trail_jabil_redesign} />
					</li>
					<li>{m.trail_jabil_inner_source()}</li>
				</ul>
				<ul slot="more">
					<li>{m.trail_jabil_jemsmm()}</li>
					<li>{m.trail_jabil_ui_ux()}</li>
					<li>{m.trail_jabil_cio()}</li>
				</ul>
			</Role>
			<Role
				title={m.role_engineer()}
				from="2017-05"
				to="2018-09"
				place={m.place_livingston()}
			>
				<ul>
					<li>{m.trail_jabil_ui_library()}</li>
					<li>{m.trail_jabil_microsoft()}</li>
				</ul>
			</Role>
		</Waypoint>
	</ol>
</section>
