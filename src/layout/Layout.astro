---
import { Font, getImage } from 'astro:assets';

import hero from '../media/hero.webp';

import Analytics from './Analytics.astro';

interface Props {
	title: string;
	// What the page is, for search results and link previews.
	description?: string;
	// Where the page lives on the site, for its canonical link.
	path?: string;
	// Whether search engines should index the page (not, say, the 404 page).
	isIndexed?: boolean;
}

const {
	title,
	description = 'Elliot Lewis: Staff Software Engineer, front-end. Los Angeles, CA.',
	path = '',
	isIndexed = true,
} = Astro.props;
const url = `https://elliotleelewis.com${path}`;

// The picture in a link preview (on LinkedIn, Slack, iMessage and the
// like): my photo, cropped to the shape previews use, around what stands
// out (my face). JPEG, as not every service reads AVIF or WebP.
const preview = await getImage({
	src: hero,
	width: 1200,
	height: 630,
	fit: 'cover',
	position: 'attention',
	format: 'jpg',
	quality: 85,
});
const previewUrl = new URL(preview.src, url).href;
---

<!doctype html>
<html lang="en" dir="ltr">
	<head>
		<meta charset="utf8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="theme-color"
			content="#eef1ec"
			media="(prefers-color-scheme: light)"
		/>
		<meta
			name="theme-color"
			content="#0e1512"
			media="(prefers-color-scheme: dark)"
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		{isIndexed ? (
			<link rel="canonical" href={url} />
		) : (
			<meta name="robots" content="noindex" />
		)}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Elliot Lewis" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{isIndexed && <meta property="og:url" content={url} />}
		<meta property="og:image" content={previewUrl} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta
			property="og:image:width"
			content={String(preview.attributes.width)}
		/>
		<meta
			property="og:image:height"
			content={String(preview.attributes.height)}
		/>
		<meta
			property="og:image:alt"
			content="Elliot smiling among pine trees, with a mountain behind him"
		/>
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:creator" content="@elliotleelewis" />
		<Font cssVariable="--font-inter" />
		<Font cssVariable="--font-fraunces" />
		<Font cssVariable="--font-jetbrains-mono" />
		<title>{title}</title>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
	</head>
	<body>
		<slot />
		<script>
			// Fade sections in as they scroll into view.
			const observer = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (entry.isIntersecting) {
							entry.target.setAttribute('data-visible', '');
							observer.unobserve(entry.target);
						}
					}
				},
				{ rootMargin: '0px 0px -10% 0px' },
			);
			for (const element of document.querySelectorAll('[data-reveal]')) {
				observer.observe(element);
			}
		</script>
		{import.meta.env.PROD && <Analytics />}
	</body>
</html>
