---
// Everything the site may keep on a visitor's device, and how to clear it.
// What leaves the device is the privacy page's. Linked from the footer.
import Layout from '../layout/Layout.astro';
import { m } from '../paraglide/messages';

import '../styles/global.css';

const CLOUDFLARE_COOKIES =
	'https://developers.cloudflare.com/fundamentals/reference/policies-compliances/cloudflare-cookies/';
// What the site keeps in local storage (see src/hero/atoms.ts).
const STORAGE = [
	{ key: 'hero-best-trees', what: m.cookies_storage_best() },
	{ key: 'hero-easter-egg-hits', what: m.cookies_storage_easter_eggs() },
	{ key: 'hero-initials', what: m.cookies_storage_initials() },
	{ key: 'theme', what: m.cookies_storage_theme() },
];
const link =
	'font-semibold text-accent underline underline-offset-4 hover:text-ink focus-visible:ring-4 focus-visible:ring-accent/50 focus-visible:outline-none';
---

<Layout
	title={m.cookies_title()}
	description={m.cookies_description()}
	path="/cookies"
>
	<main class="mx-auto max-w-3xl px-5 py-16 sm:px-8 sm:py-24">
		<p class="font-mono text-xs tracking-[0.25em] text-accent uppercase">
			{m.cookies_eyebrow()}
		</p>
		<h1 class="mt-4 font-display text-5xl font-semibold tracking-tight sm:text-7xl">
			{m.cookies_heading()}
			<span class="text-accent">.</span>
		</h1>
		<p class="mt-6 text-lg/relaxed text-ink/85">{m.cookies_intro()}</p>
		<p class="mt-4 leading-relaxed">
			<a href="/privacy" class={link}>
				{m.cookies_privacy_link()}
			</a>
		</p>

		<h2 class="mt-12 font-display text-3xl font-semibold">
			{m.cookies_cloudflare_heading()}
		</h2>
		<p class="mt-4 leading-relaxed text-ink/85">
			{m.cookies_cloudflare_body()}
		</p>
		<dl class="mt-6 grid gap-x-6 gap-y-3 rounded-2xl border border-line bg-surface p-5 sm:grid-cols-[auto_1fr]">
			<dt class="font-semibold">{m.cookies_name()}</dt>
			<dd class="font-mono text-sm">cf_clearance</dd>
			<dt class="font-semibold">{m.cookies_set_by()}</dt>
			<dd>{m.cookies_set_by_value()}</dd>
			<dt class="font-semibold">{m.cookies_purpose()}</dt>
			<dd>{m.cookies_purpose_value()}</dd>
			<dt class="font-semibold">{m.cookies_kept_for()}</dt>
			<dd>{m.cookies_kept_for_value()}</dd>
		</dl>
		<p class="mt-4 leading-relaxed">
			<a href={CLOUDFLARE_COOKIES} class={link}>
				{m.cookies_cloudflare_more()}
			</a>
		</p>

		<h2 class="mt-12 font-display text-3xl font-semibold">
			{m.cookies_storage_heading()}
		</h2>
		<p class="mt-4 leading-relaxed text-ink/85">
			{m.cookies_storage_body()}
		</p>
		<dl class="mt-6 grid gap-x-6 gap-y-3 rounded-2xl border border-line bg-surface p-5 sm:grid-cols-[auto_1fr]">
			{STORAGE.map(({ key, what }) => (
				<>
					<dt class="font-mono text-sm">{key}</dt>
					<dd>{what}</dd>
				</>
			))}
		</dl>
		<div
			id="storage"
			class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2"
			hidden
		>
			<button
				id="storage-clear"
				type="button"
				class="cursor-pointer rounded-full border border-line px-5 py-2.5 font-semibold focus-visible:ring-4 focus-visible:ring-accent/50 focus-visible:outline-none enabled:hover:bg-surface disabled:cursor-default disabled:opacity-60"
			>
				{m.cookies_storage_clear()}
			</button>
			<p
				id="storage-status"
				class="text-sm text-ink/70"
				aria-live="polite"
				data-cleared={m.cookies_storage_cleared()}
				data-empty={m.cookies_storage_empty()}
			></p>
		</div>

		<h2 class="mt-12 font-display text-3xl font-semibold">
			{m.cookies_nothing_else_heading()}
		</h2>
		<p class="mt-4 leading-relaxed text-ink/85">
			{m.cookies_nothing_else_body()}
		</p>

		<p class="mt-12">
			<a
				href="/"
				class="inline-block rounded-full bg-ink px-5 py-2.5 font-semibold text-paper hover:bg-ink/85 focus-visible:ring-4 focus-visible:ring-accent/50 focus-visible:outline-none"
			>
				{m.back_to_trailhead()}
			</a>
		</p>
	</main>
</Layout>

<script>
	// Clear what the site keeps in local storage: the game's, and the theme
	// picked, so a visitor can start afresh. Storage can be blocked, so without it the
	// button stays hidden.
	const storage = document.querySelector('#storage');
	const button = document.querySelector('#storage-clear');
	const status = document.querySelector('#storage-status');
	if (
		storage instanceof HTMLElement &&
		button instanceof HTMLButtonElement &&
		status instanceof HTMLElement
	) {
		try {
			// Reading it first, as it throws where storage is blocked.
			if (localStorage.length === 0) {
				button.disabled = true;
				status.textContent = status.dataset.empty ?? '';
			}
			button.addEventListener('click', () => {
				localStorage.clear();
				button.disabled = true;
				status.textContent = status.dataset.cleared ?? '';
			});
			storage.hidden = false;
		} catch {
			// No storage, so nothing to clear.
		}
	}
</script>
